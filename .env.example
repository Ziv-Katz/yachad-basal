# Supabase > Project Settings > API: Project URL and the anon / publishable key (never the service_role / secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public half of the VAPID key pair (npx web-push generate-vapid-keys). The private half goes into the Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=
