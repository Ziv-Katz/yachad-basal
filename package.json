{
  "name": "yachad-basal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx -y wrangler@4.20.0 pages deploy dist --project-name yachad-basal",
    "db:start": "supabase start",
    "apk": "SITE_HOST=${SITE_HOST:-yachad-basal.pages.dev} ./android/build.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "~2.81.1",
    "react": "~19.1.0",
    "react-dom": "~19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "~4.6.0",
    "supabase": "~2.58.0",
    "typescript": "~5.8.3",
    "vite": "~6.3.5",
    "vite-plugin-pwa": "~1.0.1",
    "vitest": "~3.2.4",
    "workbox-precaching": "~7.3.0"
  }
}
