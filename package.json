{
  "name": "yachad-basal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "emulators": "npm --prefix functions run build && npx -y firebase-tools@14.9.0 emulators:start --project demo-yb",
    "deploy": "npm run build && npx -y firebase-tools@14.9.0 deploy"
  },
  "dependencies": {
    "firebase": "~11.10.0",
    "react": "~19.1.0",
    "react-dom": "~19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "~4.6.0",
    "typescript": "~5.8.3",
    "vite": "~6.3.5",
    "vite-plugin-pwa": "~1.0.1",
    "vitest": "~3.2.4",
    "workbox-precaching": "~7.3.0"
  }
}
